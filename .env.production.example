# ── 生产部署配置（复制为 .env 使用；docker compose 会读取）────────────
# 与 .env.example 的差异：Cookie Secure 必须开、管理员必须指定。

# LLM 与 embedding（必填）
LEGALQA_LLM_PROVIDER=dashscope
LEGALQA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LEGALQA_EMBEDDING_PROVIDER=dashscope_native
LEGALQA_EMBEDDING_MODEL=qwen3.7-text-embedding
LEGALQA_EMBEDDING_DIMENSION=1024

# ── 安全（生产必开）──────────────────────────────────────────────
# HTTPS 反向代理（nginx/caddy）后面必须开 Secure Cookie
LEGALQA_COOKIE_SECURE=1
# 管理端管理员（先用网页注册该用户名，再填这里并重启）
LEGALQA_ADMIN_USERNAME=

# ── 限流（生产建议收紧）──────────────────────────────────────────
LEGALQA_CHAT_PER_MINUTE=6
LEGALQA_CHAT_PER_HOUR=30
LEGALQA_LOGIN_PER_MINUTE=5
LEGALQA_REGISTER_PER_MINUTE=3
