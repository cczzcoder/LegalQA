# ── LLM（云端，OpenAI 兼容端点）────────────────────────────
# 可选 provider：openai / dashscope / deepseek / zhipu / moonshot / ollama
LEGALQA_LLM_PROVIDER=dashscope
LEGALQA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 留空则用该 provider 的默认模型；也可显式指定
# LEGALQA_LLM_MODEL=qwen-plus
# 留空则用预设 base_url
# LEGALQA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 云端不需要改超时；CPU 跑本地大模型时才需要放宽
# LEGALQA_LLM_TIMEOUT=60

# ── Embedding（DashScope 原生接口，推荐）────────────────────
# 可选 provider：dashscope_native / dashscope / ollama / huggingface / hash
# dashscope_native 支持 text_type=query/document + instruct，检索效果最好
LEGALQA_EMBEDDING_PROVIDER=dashscope_native
LEGALQA_EMBEDDING_MODEL=qwen3.7-text-embedding
LEGALQA_EMBEDDING_DIMENSION=1024
LEGALQA_EMBEDDING_QUERY_INSTRUCT=Given a Chinese legal question, retrieve the statutory article that best answers it.
# 换 embedding 模型必须重建索引；run_check / run_eval 会校验索引 meta 里的模型标识

# ── Web 会话 / 限流（可选）──────────────────────────────
# 存储 / 限流外置（多 worker 部署时必配；不配则 SQLite + 进程内限流）
# LEGALQA_DATABASE_URL=postgresql://legalqa:password@127.0.0.1:5433/legalqa
# LEGALQA_REDIS_URL=redis://127.0.0.1:6380/0
# HTTPS 部署时开启 Secure Cookie
# LEGALQA_COOKIE_SECURE=1
# 聊天：每用户每分钟/每小时上限
# LEGALQA_CHAT_PER_MINUTE=10
# LEGALQA_CHAT_PER_HOUR=60
# 登录/注册：每 IP、每用户名上限
# LEGALQA_LOGIN_PER_MINUTE=8
# LEGALQA_REGISTER_PER_MINUTE=5

# 模型缓存目录（避免落在 C 盘）
# LEGALQA_MODEL_DIR=D:/pip-cache/legalmind-models

# 检索阈值 / 进 prompt 条数（实验开关；默认 0.73 / 6，见 E29 勿随意降阈值）
# LEGALQA_RAG_THRESHOLD=0.73
# LEGALQA_RAG_TOP_K=6

# 管理端：启动时把该用户名提升为管理员（先注册再配置）
LEGALQA_ADMIN_USERNAME=

# ── 邮箱验证 / 密码找回 ─────────────────────────────
# 未配 SMTP 时验证码打印到服务端控制台（开发模式）；
# 置 1 时响应里附带 console_code 字段，仅供本地调试
# LEGALQA_EMAIL_CONSOLE=0
# 配了 SMTP 后验证码改走邮件：
# LEGALQA_SMTP_HOST=smtp.example.com
# LEGALQA_SMTP_PORT=25
# LEGALQA_SMTP_FROM=legalqa@example.com
