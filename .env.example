# ── LLM（云端，OpenAI 兼容端点）────────────────────────────
# 可选 provider：openai / dashscope / deepseek / zhipu / moonshot / ollama
LEGALQA_LLM_PROVIDER=dashscope
LEGALQA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 留空则用该 provider 的默认模型；也可显式指定
# LEGALQA_LLM_MODEL=qwen-plus
# 留空则用预设 base_url
# LEGALQA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 云端不需要改超时；CPU 跑本地大模型时才需要放宽
# LEGALQA_LLM_TIMEOUT=60

# ── Embedding（本地 Ollama，不消耗 API 额度）────────────────
LEGALQA_EMBEDDING_PROVIDER=ollama
LEGALQA_EMBEDDING_MODEL=bge-m3

# 模型缓存目录（避免落在 C 盘）
# LEGALQA_MODEL_DIR=D:/pip-cache/legalmind-models
